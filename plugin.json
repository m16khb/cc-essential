{
  "name": "cc-essential",
  "version": "0.4.0",
  "description": "Claude Code 필수 플러그인 모음 - 테스트, 문서화, 코드 품질을 위한 종합 도구 세트 (Testcontainers 지원)",
  "author": "m16khb",
  "license": "MIT",
  "repository": "https://github.com/m16khb/cc-essential",
  "commands": [
    {
      "name": "atomic-commit",
      "description": "변경 사항 분석 및 Conventional Commit 분리"
    },
    {
      "name": "test-scaffold",
      "description": "NestJS Testing Module 패턴 기반 테스트 파일 생성"
    },
    {
      "name": "fixture-factory",
      "description": "타입 안전한 테스트 픽스처 생성"
    },
    {
      "name": "tsdoc-generate",
      "description": "TSDoc 표준 문서 생성"
    }
  ],
  "agents": [
    {
      "name": "commit-analyzer",
      "model": "sonnet",
      "description": "변경 사항 분석 에이전트"
    },
    {
      "name": "commit-analyzer-low",
      "model": "haiku",
      "description": "빠른 커밋 분류 체크"
    },
    {
      "name": "swagger-reviewer",
      "model": "sonnet",
      "description": "Swagger 문서화 리뷰 (상세)"
    },
    {
      "name": "swagger-reviewer-low",
      "model": "haiku",
      "description": "Swagger 문서화 리뷰 (빠른 체크)"
    },
    {
      "name": "swagger-reviewer-high",
      "model": "opus",
      "description": "프로젝트 전체 Swagger 문서화 심층 감사"
    },
    {
      "name": "coverage-advisor",
      "model": "opus",
      "description": "테스트 커버리지 심층 분석 및 누락 테스트 제안"
    },
    {
      "name": "coverage-advisor-medium",
      "model": "sonnet",
      "description": "표준 커버리지 분석 및 테스트 케이스 제안"
    },
    {
      "name": "coverage-advisor-low",
      "model": "haiku",
      "description": "빠른 커버리지 수치 확인"
    },
    {
      "name": "api-changelog",
      "model": "opus",
      "description": "API Breaking Change 감지 및 버전 관리"
    },
    {
      "name": "readme-sync",
      "model": "sonnet",
      "description": "README vs 프로젝트 상태 동기화 분석"
    },
    {
      "name": "dead-code-hunter",
      "model": "opus",
      "description": "Knip 기반 미사용 코드 탐지"
    },
    {
      "name": "dependency-auditor",
      "model": "sonnet",
      "description": "의존성 보안 및 품질 감사"
    }
  ],
  "skills": [
    {
      "name": "conventional-commit",
      "description": "Conventional Commit 형식 가이드"
    },
    {
      "name": "nestjs-swagger",
      "description": "NestJS Swagger 문서화 가이드"
    },
    {
      "name": "test-patterns",
      "description": "NestJS 테스트 패턴 및 베스트 프랙티스"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "name": "session-init",
        "matcher": "*",
        "description": "프로젝트 타입 감지 및 권장 도구 안내"
      }
    ],
    "UserPromptSubmit": [
      {
        "name": "keyword-detector",
        "matcher": "*",
        "description": "키워드 기반 도구/에이전트 추천"
      }
    ],
    "PostToolUse": [
      {
        "name": "swagger-reminder",
        "matcher": "Edit|Write",
        "description": "DTO/Controller 편집 시 Swagger 체크리스트"
      },
      {
        "name": "test-reminder",
        "matcher": "Edit|Write",
        "description": "테스트 대상 파일 편집 시 테스트 파일 존재 확인"
      },
      {
        "name": "tsdoc-reminder",
        "matcher": "Edit|Write",
        "description": "문서화되지 않은 public export 감지"
      },
      {
        "name": "api-change-detector",
        "matcher": "Edit|Write",
        "description": "Controller/DTO의 Breaking Change 감지"
      }
    ]
  },
  "keywords": [
    "nestjs",
    "swagger",
    "testing",
    "testcontainers",
    "documentation",
    "code-quality",
    "conventional-commit",
    "tsdoc"
  ]
}
